JWT_SECRET=replace-with-a-random-local-secret
# Generate once: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_SECRET_KEY=
BOOTSTRAP_ADMIN_EMAIL=owner@example.com
BOOTSTRAP_ADMIN_PASSWORD=
JWT_EXPIRE_MINUTES=480
ATTACH_MAX_FILES=5
ATTACH_MAX_MB=10
ATTACH_ALLOW_SCRIPTS=false
DATABASE_URL=sqlite+aiosqlite:///./aiteams.db
CHECKPOINT_DB=./checkpoints.db
# Optional production checkpointer: postgresql://user:password@host/checkpoint_database
# CHECKPOINT_POSTGRES_URL=
MAX_NODE_ITERATIONS=5
API_CONTEXT_DIFF_CHARS=40000
CLAUDE_ACP_BIN=claude-agent-acp
CODEX_ACP_BIN=codex-acp
ALLOWED_WORKSPACE_ROOTS=D:\VETC
ACP_PROMPT_TIMEOUT_SEC=1800
MAX_ACP_PROCESSES=6
MAX_API_CONCURRENCY=8
API_MAX_CONTEXT_CHARS=100000
API_ALLOWED_HTTP_HOSTS=localhost,127.0.0.1
API_ALLOWED_PRIVATE_HOSTS=
CORS_ORIGINS=http://localhost:3060
