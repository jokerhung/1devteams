JWT_SECRET=replace-with-a-random-local-secret
# Generate once: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_SECRET_KEY=
BOOTSTRAP_ADMIN_EMAIL=owner@example.com
BOOTSTRAP_ADMIN_PASSWORD=
JWT_EXPIRE_MINUTES=480
ATTACH_MAX_FILES=5
ATTACH_MAX_MB=10
ATTACH_ALLOW_SCRIPTS=false
ATTACH_QUOTA_MB=200
# Human terminal has OS user authority, separate from agent guard. Enable deliberately.
ENABLE_REMOTE_TERMINAL=false
# Host-operator opt-in for trusted local workspaces only. Native tools may bypass
# aiTeams permission profiles and run with the OS account's authority. Not a sandbox.
TRUSTED_NATIVE_ACP=false
# Set false when launched from an IDE/agent with temporary provider gateways.
# Explicit ANTHROPIC_*/OPENAI_* overrides in this backend/.env still apply.
ACP_INHERIT_PROVIDER_ENV=true
TERMINAL_IDLE_SECONDS=600
TERMINAL_AUDIT_INPUT=false
MAX_TERMINAL_SESSIONS=8
MAX_CONCURRENT_TICKETS=4
# Browser Worker: per-agent access is configured in Agents & Teams; no URL allowlist.
BROWSER_MAX_SESSIONS=4
BROWSER_MAX_ACTIONS=100
BROWSER_MAX_ROUNDS=30
BROWSER_ACTION_TIMEOUT_MS=15000
BROWSER_RUN_TIMEOUT_SEC=900
MAX_EVENT_CHARS=100000
OVERLOAD_PATTERNS=capacity,overloaded,429,529,rate limit
MODEL_RETRY_DELAYS=30,60
DATABASE_URL=sqlite+aiosqlite:///./aiteams.db
CHECKPOINT_DB=./checkpoints.db
# Optional production checkpointer: postgresql://user:password@host/checkpoint_database
# CHECKPOINT_POSTGRES_URL=
MAX_NODE_ITERATIONS=5
API_CONTEXT_DIFF_CHARS=40000
CLAUDE_ACP_BIN=claude-agent-acp
CODEX_ACP_BIN=codex-acp
ALLOWED_WORKSPACE_ROOTS=D:\VETC
ACP_PROMPT_TIMEOUT_SEC=1800
MAX_ACP_PROCESSES=6
MAX_API_CONCURRENCY=8
API_MAX_CONTEXT_CHARS=100000
API_ALLOWED_HTTP_HOSTS=localhost,127.0.0.1
API_ALLOWED_PRIVATE_HOSTS=
CORS_ORIGINS=http://localhost:3060
